@if (User.Identity?.IsAuthenticated ?? false)
{
    <form method="post" action="/Identity/Account/Logout" class="d-inline">
        <button type="submit" class="btn btn-link nav-link text-dark">
            Çıkış Yap
        </button>
    </form>
}
else
{
    <a class="nav-link" href="/Identity/Account/Login">Giriş Yap</a>
    <a class="nav-link" href="/Identity/Account/Register">Kayıt Ol</a>
}
