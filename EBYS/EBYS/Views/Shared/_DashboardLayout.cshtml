@using System.Text.Json
@{
    ViewData["HideNavbar"] = true;

    var currentUserName = (string?)ViewBag.CurrentUserName ?? User?.Identity?.Name ?? "User";
    var currentUserBirim = (string?)ViewBag.CurrentUserBirim ?? "Birim";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EBYS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard-fire.css" asp-append-version="true" />

    <link rel="icon" type="image/png" href="~/images/BLUE.png" asp-append-version="true" />

    <style>
        .ebys-brand-logo-img {
            width: 22px;
            height: 22px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 6px 14px rgba(13,110,253,.18));
        }

        .ebys-topbar-logo-img {
            width: 18px;
            height: 18px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 6px 14px rgba(13,110,253,.18));
        }

        /* small helper so the logout form doesn't mess spacing in topbar */
        .ebys-inlineform {
            display: inline-block;
            margin: 0;
        }
    </style>
</head>

<body class="ebys-dash">
    <div class="ebys-app" id="ebysApp">

        <div class="ebys-backdrop" id="ebysBackdrop" aria-hidden="true"></div>

        <aside class="ebys-sb" id="ebysSidebar" aria-label="EBYS Menü">
            <div class="ebys-sb-top">
                <a class="ebys-brand" asp-controller="Dashboard" asp-action="Index" title="EBYS">
                    <span class="ebys-brand-logo">
                        <img src="~/images/BLUE.png" asp-append-version="true" class="ebys-brand-logo-img" alt="EBYS Logo" />
                    </span>
                    <span class="ebys-brand-text">EBYS</span>
                </a>

                <button type="button" class="ebys-iconbtn" id="btnSbCollapse" title="Sidebar küçült">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
            </div>

            <div class="ebys-sb-section">
                <div class="small text-muted mb-2">Menü</div>

                <nav class="ebys-nav">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="ebys-navlink @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       data-title="Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <div class="txt">
                            <div class="label">Dashboard</div>
                            <div class="hint">Genel görünüm</div>
                        </div>
                    </a>

                    <a class="ebys-navlink ajax" data-url="/Document/Inbox" data-title="Gelen Kutusu">
                        <i class="bi bi-inbox"></i>
                        <div class="txt">
                            <div class="label">Gelen Kutusu</div>
                            <div class="hint">İmzacı bekleyen</div>
                        </div>
                        <span id="b-inbox" class="badge text-bg-light border ms-auto">0</span>
                    </a>

                    <!-- ✅ NEW: TASLAKLAR (AJAX) -->
                    <a class="ebys-navlink ajax" data-url="/Document/Drafts" data-title="Taslaklar">
                        <i class="bi bi-pencil-square"></i>
                        <div class="txt">
                            <div class="label">Taslaklar</div>
                            <div class="hint">Kaydedilen taslaklar</div>
                        </div>
                        <span id="b-drafts" class="badge text-bg-light border ms-auto">0</span>
                    </a>

                    <a class="ebys-navlink ajax" data-url="/Document/Outbox" data-title="Giden Kutusu">
                        <i class="bi bi-send"></i>
                        <div class="txt">
                            <div class="label">Giden Kutusu</div>
                            <div class="hint">Gönderilen</div>
                        </div>
                        <span id="b-outbox" class="badge text-bg-light border ms-auto">0</span>
                    </a>

                    <a class="ebys-navlink ajax" data-url="/Document/Archive" data-title="Arşiv">
                        <i class="bi bi-archive"></i>
                        <div class="txt">
                            <div class="label">Arşiv</div>
                            <div class="hint">Kapanan kayıtlar</div>
                        </div>
                        <span id="b-archive" class="badge text-bg-light border ms-auto">0</span>
                    </a>
                </nav>
            </div>

            <div class="ebys-sb-foot">
                <div class="ebys-userpill" title="@currentUserBirim">
                    <div class="avatar"><i class="bi bi-person-fill"></i></div>
                    <div class="meta">
                        <div class="name">@currentUserName</div>
                        <div class="dept">@currentUserBirim</div>
                    </div>
                </div>

                <div class="mt-2 d-grid gap-2">
                    <a class="btn btn-primary ebys-btn" asp-controller="Document" asp-action="Create">
                        <i class="bi bi-file-earmark-plus me-2"></i>Yeni Belge
                    </a>

                    <button type="button" class="btn btn-outline-secondary ebys-btn" id="btnMockRefresh">
                        <i class="bi bi-arrow-clockwise me-2"></i>Mock Yenile
                    </button>
                </div>

                <hr class="ebys-hr" />

                <div class="d-grid gap-2">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="/" />
                            <button type="submit" class="btn btn-outline-danger ebys-btn w-100">
                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary ebys-btn"
                           asp-area="Identity" asp-page="/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                        </a>
                    }
                </div>
            </div>
        </aside>

        <main class="ebys-main">
            <header class="ebys-topbar-wrap">
                <div class="ebys-topbar">
                    <div class="ebys-topbar-left">
                        <div class="ebys-title">
                            <div class="ebys-title-main">
                                <img src="~/images/BLUE.png" asp-append-version="true" class="ebys-topbar-logo-img me-2" alt="EBYS" />
                                <span id="dashTitle">@ViewData["Title"]</span>
                            </div>
                            <div class="ebys-title-sub">Panellerin çoğu JS-only mock (backend yok)</div>
                        </div>

                        <div class="ebys-breadcrumb" aria-label="Breadcrumb">
                            <span class="crumb"><i class="bi bi-house-door me-1"></i>EBYS</span>
                            <i class="bi bi-chevron-right sep"></i>
                            <span class="crumb" id="crumbStep">@ViewData["Title"]</span>
                            <i class="bi bi-chevron-right sep d-none d-md-inline"></i>
                            <span class="crumb muted d-none d-md-inline" id="crumbHint">Genel görünüm</span>
                        </div>
                    </div>

                    <div class="ebys-topbar-right">
                        <div class="ebys-actions">
                            <button type="button" class="btn btn-outline-secondary ebys-btn" id="btnSbOpen" title="Menü">
                                <i class="bi bi-list me-2"></i>Menü
                            </button>

                            <button type="button" class="btn btn-outline-secondary ebys-btn" id="btnDemoToast">
                                <i class="bi bi-bell me-2"></i>Bildirim
                            </button>

                            <a class="btn btn-primary ebys-btn" asp-controller="Document" asp-action="Create">
                                <i class="bi bi-file-earmark-plus me-2"></i>Yeni Belge
                            </a>

                            <!-- ✅ NEW: HEADER LOGOUT BUTTON -->
                            @if (User?.Identity?.IsAuthenticated == true)
                            {
                                <form class="ebys-inlineform" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button type="submit" class="btn btn-outline-danger ebys-btn" title="Çıkış Yap">
                                        <i class="bi bi-box-arrow-right me-2"></i>Çıkış
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary ebys-btn"
                                   asp-area="Identity" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Giriş
                                </a>
                            }
                        </div>
                    </div>
                </div>

                <div class="ebys-topnote px-1">
                    <div class="ebys-savehint" id="dashStatus">—</div>
                    <button type="button" class="ebys-hotkeybtn" id="dashClockBtn" title="Zaman">
                        <i class="bi bi-clock"></i>
                        <span class="d-none d-md-inline" id="dashClock">—</span>
                    </button>
                </div>
            </header>

            <div class="ebys-content" id="content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        window.EBYS_DASH_CTX = {
            userName: @Html.Raw(JsonSerializer.Serialize(currentUserName)),
            birim: @Html.Raw(JsonSerializer.Serialize(currentUserBirim))
        };
    </script>

    <script src="~/js/dashboard-fire.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
