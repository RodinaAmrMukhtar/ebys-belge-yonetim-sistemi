@model List<EBYS.Models.Document>

@{
    ViewData["Title"] = "Arşiv";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- ================= SIMPLE HEADER ================= -->
<header class="ebys-minihead">
    <div class="left">
        <a class="brand" asp-controller="Home" asp-action="Index" title="EBYS">
            <img src="~/images/BLUE.png" class="logo" alt="EBYS Logo" />
            <span class="name">EBYS</span>
        </a>

        <span class="sep"></span>

        <div class="title">
            <div class="h1"><i class="bi bi-archive me-2"></i>Arşiv</div>
            <div class="sub">Kapanan kayıtlar • geri yükleme işlemleri</div>
        </div>
    </div>

    <div class="right">
        <button type="button" class="btn btn-outline-secondary ebys-btn" onclick="history.back()">
            <i class="bi bi-arrow-left me-2"></i>Geriye Dön
        </button>

        <span class="countpill">
            <i class="bi bi-folder2-open me-2"></i>@(Model?.Count ?? 0) belge
        </span>
    </div>
</header>

<!-- ================= GLASS CARD ================= -->
<div class="ebys-glasscard">

    @if (Model == null || Model.Count == 0)
    {
        <div class="ebys-empty">
            <div class="icon"><i class="bi bi-archive"></i></div>
            <div>
                <div class="fw-bold">Arşiv boş</div>
                <div class="text-muted small">Henüz arşivlenmiş belge bulunmuyor.</div>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table ebys-table align-middle">
                <thead>
                    <tr>
                        <th style="width:170px;">Sayı</th>
                        <th>Başlık</th>
                        <th style="width:180px;">Durum</th>
                        <th style="width:220px;" class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="text-muted">
                                <span class="ebys-mono">@(string.IsNullOrWhiteSpace(d.Sayi) ? "—" : d.Sayi)</span>
                            </td>

                            <td>
                                <div class="fw-semibold">@d.Baslik</div>
                                <div class="small text-muted">Konu: @(string.IsNullOrWhiteSpace(d.Konu) ? "—" : d.Konu)</div>
                            </td>

                            <td>
                                <span class="@StatusClass(d.Durum)">
                                    <i class="bi @StatusIcon(d.Durum) me-2"></i>@StatusText(d.Durum)
                                </span>
                            </td>

                            <td class="text-end">
                                <form asp-action="Restore" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />

                                    <button class="btn btn-sm btn-success ebys-btn-sm">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Geri Yükle
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string StatusText(string? d) => d switch
    {
        "Draft" => "Taslak",
        "Sent" => "İmza Bekliyor",
        "Approved" => "Onaylandı",
        "Rejected" => "Reddedildi",
        "Archived" => "Arşivlendi",
        _ => string.IsNullOrWhiteSpace(d) ? "—" : d!
    };

    string StatusIcon(string? d) => d switch
    {
        "Draft" => "bi-pencil-square",
        "Sent" => "bi-hourglass-split",
        "Approved" => "bi-check2-circle",
        "Rejected" => "bi-x-circle",
        "Archived" => "bi-archive",
        _ => "bi-dot"
    };

    string StatusClass(string? d) => d switch
    {
        "Draft" => "st-pill st-draft",
        "Sent" => "st-pill st-sent",
        "Approved" => "st-pill st-approved",
        "Rejected" => "st-pill st-rejected",
        "Archived" => "st-pill st-archived",
        _ => "st-pill st-draft"
    };
}

<style>
    :root {
        --ink: #0f172a;
        --muted: #64748b;
        --glass-bg: rgba(255,255,255,.72);
        --glass-bd: rgba(255,255,255,.40);
        --shadow: 0 20px 60px rgba(0,0,0,.12);
    }

    body {
        background: radial-gradient(1200px 600px at 10% 0%, rgba(13,110,253,.14), transparent 55%), radial-gradient(900px 520px at 100% 10%, rgba(99,102,241,.12), transparent 55%), #f6f7fb;
    }

    /* ===== header ===== */
    .ebys-minihead {
        position: sticky;
        top: 0;
        z-index: 20;
        margin: 8px 0 12px;
        padding: 10px 12px;
        border-radius: 16px;
        background: var(--glass-bg);
        border: 1px solid var(--glass-bd);
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .ebys-minihead .left {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 260px;
        }

    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .logo {
        width: 34px;
        height: 34px;
        object-fit: contain;
    }

    .name {
        font-weight: 950;
        letter-spacing: .2px;
        color: var(--ink);
        font-size: 1rem;
    }

    .sep {
        width: 1px;
        height: 28px;
        background: rgba(15,23,42,.10);
        border-radius: 99px;
    }

    .title .h1 {
        font-weight: 950;
        color: var(--ink);
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        margin: 0;
    }

    .title .sub {
        color: var(--muted);
        font-size: .82rem;
        margin-top: 2px;
    }

    .ebys-minihead .right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .countpill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(15,23,42,.10);
        color: var(--ink);
        font-weight: 900;
        font-size: .86rem;
        white-space: nowrap;
    }

    .ebys-btn {
        border-radius: 12px;
        font-weight: 900;
        box-shadow: 0 10px 24px rgba(0,0,0,.08);
        transition: transform .18s ease, box-shadow .18s ease;
    }

        .ebys-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(0,0,0,.10);
        }

    /* ===== glass card ===== */
    .ebys-glasscard {
        background: var(--glass-bg);
        border: 1px solid var(--glass-bd);
        border-radius: 18px;
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        padding: 14px;
        animation: fadeUp .22s ease;
    }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ===== table ===== */
    .ebys-table thead th {
        color: rgba(15,23,42,.75);
        font-weight: 950;
        border-bottom: 1px solid rgba(15,23,42,.10);
        background: rgba(255,255,255,.70);
        white-space: nowrap;
    }

    .ebys-table tbody tr {
        border-bottom: 1px dashed rgba(15,23,42,.10);
    }

        .ebys-table tbody tr:hover {
            background: rgba(13,110,253,.05);
        }

    .ebys-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
        font-weight: 750;
    }

    .ebys-btn-sm {
        border-radius: 12px;
        font-weight: 950;
    }

    /* ===== empty state ===== */
    .ebys-empty {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 14px;
        border: 1px dashed rgba(15,23,42,.16);
        border-radius: 16px;
        background: rgba(255,255,255,.55);
    }

        .ebys-empty .icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: rgba(13,110,253,.10);
            border: 1px solid rgba(13,110,253,.18);
            color: #0d6efd;
            font-size: 1.25rem;
        }

    /* ===== status pill (not white) ===== */
    .st-pill {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-weight: 950;
        font-size: .86rem;
        border: 1px solid rgba(0,0,0,.10);
        box-shadow: 0 14px 30px rgba(0,0,0,.06);
        white-space: nowrap;
    }

    .st-draft {
        background: rgba(148,163,184,.22);
        border-color: rgba(148,163,184,.35);
        color: #334155;
    }

    .st-sent {
        background: rgba(255,193,7,.22);
        border-color: rgba(255,193,7,.35);
        color: #664d03;
    }

    .st-approved {
        background: rgba(25,135,84,.18);
        border-color: rgba(25,135,84,.28);
        color: #0f5132;
    }

    .st-rejected {
        background: rgba(220,53,69,.16);
        border-color: rgba(220,53,69,.26);
        color: #842029;
    }

    .st-archived {
        background: rgba(108,117,125,.18);
        border-color: rgba(108,117,125,.28);
        color: #343a40;
    }

    /* responsive */
    @@media (max-width: 768px) {
        .ebys-minihead

    {
        align-items: flex-start;
    }

    .sep {
        display: none;
    }

    .title .sub {
        display: none;
    }

    }
</style>
