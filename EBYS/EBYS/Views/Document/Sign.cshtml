@model EBYS.Models.Document

@{
    ViewData["Title"] = "Belge İmzalama";

    bool isApproved = Model.Durum == "Approved";
    bool isRejected = Model.Durum == "Rejected";
    bool isPending = !isApproved && !isRejected;

    string statusText = isApproved ? "Onaylandı" : isRejected ? "Reddedildi" : "İmza Bekliyor";
    string statusIcon = isApproved ? "bi-check2-circle" : isRejected ? "bi-x-circle" : "bi-hourglass-split";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --ink: #0f172a;
        --muted: #64748b;
        --bd: rgba(15,23,42,.10);
        --glass: rgba(255,255,255,.70);
        --glass2: rgba(255,255,255,.55);
        --shadow: 0 22px 70px rgba(0,0,0,.16);
    }

    body {
        background: radial-gradient(1200px 700px at 10% 0%, rgba(13,110,253,.14), transparent 55%), radial-gradient(900px 520px at 100% 10%, rgba(99,102,241,.12), transparent 55%), #f6f7fb;
    }

    .ebys-wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 18px 12px 30px;
        animation: ebysIn .35s ease;
    }

    @@keyframes ebysIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ebys-glass {
        position: relative;
        background: var(--glass);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,.55);
        border-radius: 18px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

        .ebys-glass::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(120deg, rgba(13,110,253,.16), rgba(255,255,255,0), rgba(99,102,241,.14));
            opacity: .55;
            pointer-events: none;
        }

    .ebys-head {
        position: relative;
        padding: 18px 18px 14px;
        border-bottom: 1px solid rgba(15,23,42,.06);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .ebys-title {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        min-width: 0;
    }

        .ebys-title .icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: rgba(13,110,253,.10);
            border: 1px solid rgba(13,110,253,.18);
            color: #0d6efd;
            box-shadow: 0 14px 30px rgba(13,110,253,.12);
            flex: 0 0 auto;
        }

        .ebys-title h5 {
            margin: 0;
            font-weight: 900;
            color: var(--ink);
            letter-spacing: .1px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .ebys-sub {
        color: var(--muted);
        font-size: .86rem;
        margin-top: 2px;
    }

    .status-pill {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        font-weight: 800;
        font-size: .86rem;
        border: 1px solid rgba(15,23,42,.10);
        background: rgba(255,255,255,.72);
        box-shadow: 0 14px 30px rgba(0,0,0,.06);
        white-space: nowrap;
        flex: 0 0 auto;
    }

        .status-pill .dot {
            width: 9px;
            height: 9px;
            border-radius: 999px;
            box-shadow: 0 0 0 5px rgba(0,0,0,.04);
        }

    .status-approved .dot {
        background: rgba(25,135,84,1);
        box-shadow: 0 0 0 5px rgba(25,135,84,.12);
    }

    .status-rejected .dot {
        background: rgba(220,53,69,1);
        box-shadow: 0 0 0 5px rgba(220,53,69,.12);
    }

    .status-pending .dot {
        background: rgba(255,193,7,1);
        box-shadow: 0 0 0 5px rgba(255,193,7,.14);
    }

    .ebys-body {
        position: relative;
        padding: 16px 18px 18px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .ebys-card {
        background: rgba(255,255,255,.78);
        border: 1px solid rgba(15,23,42,.08);
        border-radius: 16px;
        box-shadow: 0 18px 50px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .ebys-card-h {
        padding: 12px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-bottom: 1px solid rgba(15,23,42,.06);
        background: rgba(255,255,255,.55);
    }

        .ebys-card-h .t {
            font-weight: 900;
            color: var(--ink);
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: .92rem;
        }

    .ebys-card-b {
        padding: 14px;
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
    }

    .meta-item {
        border: 1px dashed rgba(15,23,42,.14);
        border-radius: 14px;
        padding: 10px 12px;
        background: rgba(255,255,255,.60);
        min-width: 0;
    }

        .meta-item .k {
            font-size: .78rem;
            color: var(--muted);
            margin-bottom: 3px;
        }

        .meta-item .v {
            font-weight: 850;
            color: var(--ink);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .stamp {
        border-radius: 14px;
        padding: 10px 12px;
        border: 1px solid rgba(15,23,42,.08);
        background: rgba(255,255,255,.70);
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: .90rem;
    }

        .stamp i {
            font-size: 1.1rem;
            margin-top: 1px;
        }

    .pdf-frame {
        width: 100%;
        height: 560px;
        border: 0;
        border-radius: 14px;
        background: #fff;
    }

    .pdf-shell {
        border-radius: 16px;
        border: 1px solid rgba(15,23,42,.10);
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(0,0,0,.10);
        background: #fff;
    }

    .content-body {
        line-height: 1.6;
        color: var(--ink);
    }

    .ebys-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .ebys-btn {
        border-radius: 12px;
        padding: 10px 14px;
        box-shadow: 0 12px 28px rgba(0,0,0,.10);
        transition: transform .18s ease, box-shadow .18s ease;
        font-weight: 800;
    }

        .ebys-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 16px 34px rgba(0,0,0,.12);
        }

    @@media (max-width: 992px) {
        .meta-grid {
            grid-template-columns: 1fr;
        }

        .pdf-frame {
            height: 520px;
        }
    }
</style>

<div class="ebys-wrap">
    <div class="ebys-glass">

        <div class="ebys-head">
            <div class="ebys-title">
                <div class="icon"><i class="bi bi-pen"></i></div>
                <div class="min-w-0">
                    <h5>Belge İmzalama</h5>
                    <div class="ebys-sub">Elektronik Belge Yönetim Sistemi • Belgeyi inceleyip karar verin</div>
                </div>
            </div>

            <div class="status-pill @(isApproved ? "status-approved" : isRejected ? "status-rejected" : "status-pending")">
                <span class="dot"></span>
                <i class="bi @statusIcon"></i>
                <span>@statusText</span>
            </div>
        </div>

        <div class="ebys-body">

            @if (isApproved && Model.ApprovedAt != null)
            {
                <div class="stamp">
                    <i class="bi bi-check2-circle text-success"></i>
                    <div>
                        <div class="fw-bold">Onay Kaydı</div>
                        <div class="text-muted small">
                            Bu belge <strong>@Model.ApprovedAt.Value.ToString("dd.MM.yyyy HH:mm")</strong> tarihinde onaylandı.
                        </div>
                    </div>
                </div>
            }
            else if (isRejected && Model.RejectedAt != null)
            {
                <div class="stamp">
                    <i class="bi bi-x-circle text-danger"></i>
                    <div>
                        <div class="fw-bold">Red Kaydı</div>
                        <div class="text-muted small">
                            Bu belge <strong>@Model.RejectedAt.Value.ToString("dd.MM.yyyy HH:mm")</strong> tarihinde reddedildi.
                        </div>
                    </div>
                </div>
            }

            <div class="ebys-card">
                <div class="ebys-card-h">
                    <div class="t"><i class="bi bi-info-circle"></i> Belge Bilgileri</div>
                    <span class="badge text-bg-light border">ID: @Model.Id</span>
                </div>
                <div class="ebys-card-b">
                    <div class="meta-grid">
                        <div class="meta-item">
                            <div class="k">Sayı</div>
                            <div class="v">@(string.IsNullOrWhiteSpace(Model.Sayi) ? "—" : Model.Sayi)</div>
                        </div>
                        <div class="meta-item">
                            <div class="k">Başlık</div>
                            <div class="v">@Model.Baslik</div>
                        </div>
                        <div class="meta-item">
                            <div class="k">Konu</div>
                            <div class="v">@Model.Konu</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ebys-card">
                <div class="ebys-card-h">
                    <div class="t"><i class="bi bi-file-earmark-pdf"></i> PDF Ön İzleme</div>
                    <a class="btn btn-sm btn-outline-primary"
                       href="@Url.Action("Pdf", "Document", new { id = Model.Id })"
                       target="_blank" rel="noopener">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Yeni sekmede aç
                    </a>
                </div>
                <div class="ebys-card-b">
                    <div class="pdf-shell">
                        <iframe class="pdf-frame"
                                src="@Url.Action("Pdf", "Document", new { id = Model.Id })"
                                title="Belge PDF Ön İzleme"></iframe>
                    </div>
                </div>
            </div>

            <div class="ebys-card">
                <div class="ebys-card-h">
                    <div class="t"><i class="bi bi-file-text"></i> Belge İçeriği</div>
                    <span class="badge text-bg-light border">HTML</span>
                </div>
                <div class="ebys-card-b content-body">
                    @Html.Raw(Model.EditorContent)
                </div>
            </div>

            @if (isPending)
            {
                <form method="post" id="signForm" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="documentId" value="@Model.Id" />

                    <div class="ebys-actions">
                        <!-- ✅ Explicit formaction so it ALWAYS posts correctly -->
                        <button type="submit"
                                class="btn btn-success ebys-btn"
                                id="btnApprove"
                                formaction="@Url.Action("Approve", "Document")">
                            <i class="bi bi-check-circle me-2"></i>Onayla
                        </button>

                        <button type="submit"
                                class="btn btn-outline-danger ebys-btn"
                                id="btnReject"
                                formaction="@Url.Action("Reject", "Document")">
                            <i class="bi bi-x-circle me-2"></i>Reddet
                        </button>
                    </div>
                </form>

                <script>
                    (function () {
                        const form = document.getElementById('signForm');
                        const a = document.getElementById('btnApprove');
                        const r = document.getElementById('btnReject');

                        form?.addEventListener('submit', (e) => {
                            const s = e.submitter;
                            if (s === a && r) r.disabled = true;
                            if (s === r && a) a.disabled = true;
                        });

                        window.addEventListener('pageshow', () => {
                            if (a) a.disabled = false;
                            if (r) r.disabled = false;
                        });
                    })();
                </script>
            }
            else
            {
                <div class="stamp">
                    <i class="bi bi-shield-check text-primary"></i>
                    <div>
                        <div class="fw-bold">İşlem tamamlandı</div>
                        <div class="text-muted small">Bu belge için onay/red işlemi daha önce verilmiş.</div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
