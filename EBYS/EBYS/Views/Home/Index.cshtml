    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Reveal animations
        (() => {
            const els = document.querySelectorAll('.reveal');
            const io = new IntersectionObserver((entries) => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        e.target.classList.add('in');
                        io.unobserve(e.target);
                    }
                });
            }, { threshold: 0.12 });
            els.forEach(el => io.observe(el));
        })();

        // HeyGen autoplay reinforcement
        (() => {
            const frame = document.getElementById('heygenFrame');
            if (!frame) return;
            const base = "https://app.heygen.com/embedded-player/978f1b4d48db4a7ead7785383278f8b7";
            const want = base + "?autoplay=1&muted=1";
            if (!String(frame.src).includes("autoplay=1")) frame.src = want;
        })();
    </script>
