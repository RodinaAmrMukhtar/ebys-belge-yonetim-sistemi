@{
    Layout = null;
    ViewData["Title"] = "EBYS";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EBYS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --bg: #f6f7fb;
            --ink: #0f172a;
            --muted: #64748b;
            --glass: rgba(255,255,255,.66);
            --glassBd: rgba(255,255,255,.40);
            --shadow: 0 18px 55px rgba(0,0,0,.14);
            --shadow2: 0 12px 30px rgba(0,0,0,.10);
            --primary: #0d6efd;
        }

        body {
            min-height: 100vh;
            color: var(--ink);
            background: radial-gradient(1200px 650px at 10% 0%, rgba(13,110,253,.14), transparent 55%), radial-gradient(900px 520px at 100% 10%, rgba(99,102,241,.12), transparent 55%), radial-gradient(900px 520px at 40% 100%, rgba(16,185,129,.10), transparent 60%), var(--bg);
            overflow-x: hidden;
        }

        .glass {
            background: var(--glass);
            border: 1px solid var(--glassBd);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: var(--shadow);
            border-radius: 18px;
        }

        .glass-soft {
            background: rgba(255,255,255,.78);
            border: 1px solid rgba(15,23,42,.08);
            border-radius: 16px;
            box-shadow: 0 14px 40px rgba(0,0,0,.06);
        }

        /* ===== Topbar ===== */
        .topbar-wrap {
            position: sticky;
            top: 0;
            z-index: 100;
            padding: 10px 12px;
        }

        /* ✅ NEW: make header narrower (not full width) */
        .topbar-shell {
            max-width: 980px; /* change 980px to 860px if you want even smaller */
            margin: 0 auto;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--ink);
        }

            /* ✅ NEW: Blue logo next to EBYS (small + clean) */
            .brand img {
                width: 28px;
                height: 28px;
                object-fit: contain;
                display: block;
                filter: drop-shadow(0 6px 14px rgba(13,110,253,.18));
            }

            .brand .t {
                display: flex;
                flex-direction: column;
                line-height: 1.05
            }

                .brand .t .name {
                    font-weight: 950;
                    letter-spacing: .2px
                }

                .brand .t .sub {
                    font-size: .78rem;
                    color: var(--muted);
                    margin-top: 2px
                }

        .top-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap
        }

        .btn-ebys {
            border-radius: 999px;
            padding: 9px 14px;
            box-shadow: 0 10px 24px rgba(0,0,0,.08);
            transition: transform .18s ease, box-shadow .18s ease;
            font-weight: 800;
        }

            .btn-ebys:hover {
                transform: translateY(-1px);
                box-shadow: 0 14px 30px rgba(0,0,0,.10);
            }

        /* ===== Outlook-like HERO ===== */
        .hero {
            padding: 18px 12px 8px;
        }

        .hero-card {
            border-radius: 26px;
            overflow: hidden;
            position: relative;
        }

            .hero-card::before {
                content: "";
                position: absolute;
                inset: -2px;
                background: radial-gradient(760px 320px at 10% 15%, rgba(13,110,253,.18), transparent 60%), radial-gradient(680px 300px at 95% 18%, rgba(99,102,241,.16), transparent 60%), radial-gradient(680px 340px at 45% 120%, rgba(16,185,129,.12), transparent 60%);
                pointer-events: none;
            }

        .hero-inner {
            position: relative;
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            gap: 18px;
            align-items: center;
            padding: 26px;
        }

        .hero-left .kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.72);
            border: 1px solid rgba(15,23,42,.08);
            font-weight: 800;
            font-size: .82rem;
            color: var(--ink);
        }

        .hero-left h1 {
            margin: 14px 0 10px;
            font-weight: 950;
            letter-spacing: -.6px;
            color: var(--ink);
            font-size: clamp(34px, 3.8vw, 58px);
            line-height: 1.05;
        }

        .hero-left p {
            margin: 0 0 18px;
            color: var(--muted);
            max-width: 60ch;
            font-size: 1.05rem;
        }

        .hero-cta {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

            .hero-cta .btn {
                border-radius: 14px;
                padding: 12px 16px;
                font-weight: 900;
                box-shadow: var(--shadow2);
            }

        .hero-right {
            display: grid;
            place-items: center;
        }

        .shot-frame {
            width: 100%;
            border-radius: 22px;
            overflow: hidden;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(255,255,255,.88);
            box-shadow: 0 22px 70px rgba(0,0,0,.14);
            position: relative;
        }

        .shot-topbar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 12px;
            border-bottom: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.75);
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: rgba(15,23,42,.16)
        }

        .shot-title {
            margin-left: 8px;
            font-size: .82rem;
            color: var(--muted);
            font-weight: 700;
        }

        .shot-body {
            min-height: 310px;
            background: linear-gradient(180deg, rgba(15,23,42,.03), transparent 30%), rgba(255,255,255,.78);
            display: grid;
            place-items: center;
            padding: 14px;
        }

            .shot-body img {
                width: 100%;
                height: 310px;
                object-fit: cover;
                display: block;
            }

        .shot-placeholder {
            text-align: center;
            color: var(--muted);
            padding: 22px;
        }

            .shot-placeholder .ic {
                width: 56px;
                height: 56px;
                border-radius: 18px;
                display: grid;
                place-items: center;
                background: rgba(13,110,253,.10);
                border: 1px solid rgba(13,110,253,.18);
                color: var(--primary);
                margin: 0 auto 10px;
                font-size: 1.6rem;
            }

            .shot-placeholder .t {
                font-weight: 900;
                color: var(--ink);
                margin: 0;
            }

            .shot-placeholder .d {
                margin: 6px 0 0;
                font-size: .92rem;
            }

        .sec-title {
            font-weight: 950;
            margin: 0
        }

        .sec-sub {
            color: var(--muted);
            margin: 0;
            font-size: .92rem
        }

        .row-2col {
            padding: 12px
        }

        .panel {
            padding: 14px
        }

        .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 10px;
        }

            .panel-head .left {
                display: flex;
                align-items: center;
                gap: 10px
            }

            .panel-head .icon {
                width: 38px;
                height: 38px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                background: rgba(13,110,253,.10);
                border: 1px solid rgba(13,110,253,.18);
                color: var(--primary);
                font-size: 1.15rem;
            }

        .video-wrap {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(15,23,42,.10);
            background: #fff;
            box-shadow: var(--shadow2);
        }

            .video-wrap iframe {
                width: 100%;
                height: 360px;
                border: 0;
                display: block;
                background: #fff;
            }

        .ann-wrap {
            height: 360px;
            display: flex;
            flex-direction: column
        }

        .ann-list {
            margin-top: 10px;
            overflow: auto;
            padding-right: 6px
        }

        .ann-item {
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.85);
            border-radius: 14px;
            padding: 12px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
            transition: transform .16s ease, box-shadow .16s ease;
        }

            .ann-item + .ann-item {
                margin-top: 10px
            }

            .ann-item:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 26px rgba(0,0,0,.08)
            }

        .ann-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            margin-top: 5px;
            background: rgba(13,110,253,.75)
        }

        .ann-item .t {
            font-weight: 900;
            margin: 0
        }

        .ann-item .d {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: .9rem
        }

        .ann-meta {
            display: flex;
            gap: 10px;
            margin-top: 8px;
            color: var(--muted);
            font-size: .82rem
        }

        .cards-sec {
            padding: 12px
        }

        .feat-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px
        }

        .feat {
            padding: 14px;
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.86);
            box-shadow: 0 14px 40px rgba(0,0,0,.06);
            transition: transform .18s ease, box-shadow .18s ease;
            position: relative;
            overflow: hidden;
        }

            .feat::after {
                content: "";
                position: absolute;
                inset: auto -40px -50px auto;
                width: 140px;
                height: 140px;
                border-radius: 999px;
                background: rgba(13,110,253,.10);
            }

            .feat:hover {
                transform: translateY(-2px);
                box-shadow: 0 18px 55px rgba(0,0,0,.10)
            }

            .feat .i {
                width: 40px;
                height: 40px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                background: rgba(13,110,253,.10);
                border: 1px solid rgba(13,110,253,.18);
                color: var(--primary);
                font-size: 1.2rem;
                margin-bottom: 10px;
            }

            .feat h6 {
                font-weight: 950;
                margin: 0
            }

            .feat p {
                color: var(--muted);
                margin: 6px 0 0;
                font-size: .92rem
            }

        .gallery {
            padding: 12px
        }

        .shots {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 12px
        }

        .shot {
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid rgba(15,23,42,.10);
            background: rgba(255,255,255,.9);
            box-shadow: 0 18px 55px rgba(0,0,0,.10);
            position: relative;
            min-height: 210px;
        }

            .shot img {
                width: 100%;
                height: 210px;
                object-fit: cover;
                display: block;
                transform: scale(1.02);
                transition: transform .35s ease;
            }

            .shot:hover img {
                transform: scale(1.06)
            }

            .shot .cap {
                position: absolute;
                left: 12px;
                right: 12px;
                bottom: 12px;
                padding: 10px 12px;
                border-radius: 16px;
                background: rgba(255,255,255,.72);
                border: 1px solid rgba(255,255,255,.40);
                backdrop-filter: blur(14px);
            }

                .shot .cap .t {
                    font-weight: 950;
                    margin: 0
                }

                .shot .cap .d {
                    color: var(--muted);
                    margin: 3px 0 0;
                    font-size: .86rem
                }

        .support {
            padding: 12px 12px 22px
        }

        .support-grid {
            display: grid;
            grid-template-columns: 1.2fr .8fr;
            gap: 12px
        }

        .support .box {
            padding: 16px
        }

        .link-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.82);
            border: 1px solid rgba(15,23,42,.10);
            text-decoration: none;
            color: var(--ink);
            font-weight: 800;
        }

        .reveal {
            opacity: 0;
            transform: translateY(10px);
            transition: opacity .45s ease, transform .45s ease
        }

            .reveal.in {
                opacity: 1;
                transform: translateY(0)
            }

        @@media (prefers-reduced-motion: reduce) {
            .reveal {
                opacity: 1;
                transform: none
            }

            .btn-ebys, .feat, .ann-item {
                transition: none
            }
        }

        @@media (max-width: 1200px) {
            .feat-grid {
                grid-template-columns: repeat(2,1fr)
            }
        }

        @@media (max-width: 992px) {
            .hero-inner {
                grid-template-columns: 1fr
            }

            .video-wrap iframe, .ann-wrap {
                height: 320px
            }

            .shots {
                grid-template-columns: 1fr
            }

            .support-grid {
                grid-template-columns: 1fr
            }
            /* on mobile, allow header to use full width */
            .topbar-shell {
                max-width: 100%;
            }
        }

        @@media (max-width: 576px) {
            .video-wrap iframe, .ann-wrap {
                height: 280px
            }
        }
    </style>
</head>

<body>
    <!-- ===== Topbar ===== -->
    <div class="topbar-wrap">
        <!-- ✅ NEW wrapper for narrower header -->
        <div class="topbar-shell">
            <header class="topbar glass">
                <a class="brand" asp-controller="Home" asp-action="Index" aria-label="EBYS">
                    <!-- ✅ BLUE.png before EBYS (correct folder: /images) -->
                    <img src="~/images/BLUE.png" asp-append-version="true" alt="EBYS Logo"
                         onerror="this.style.display='none'">
                    <div class="t">
                        <div class="name">EBYS</div>
                        <div class="sub">Elektronik Belge Yönetim Sistemi</div>
                    </div>
                </a>

                <div class="top-actions">
                    <a class="btn btn-outline-primary btn-ebys"
                       asp-area="Identity" asp-page="/Account/Login">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                    </a>

                    <a class="btn btn-primary btn-ebys"
                       asp-area="Identity" asp-page="/Account/Register">
                        <i class="bi bi-person-plus me-2"></i>Kayıt Ol
                    </a>
                </div>
            </header>
        </div>
    </div>

    <div class="container-xl">
        <!-- ===== HERO (Outlook-like) ===== -->
        <section class="hero">
            <div class="hero-card glass reveal">
                <div class="hero-inner">
                    <div class="hero-left">
                        <div class="kicker">
                            <i class="bi bi-shield-check"></i>
                            Güvenli • Hızlı • Kurumsal
                        </div>

                        <h1>EBYS’ye Hoş Geldiniz</h1>
                        <p>
                            Belge oluşturun, imzaya gönderin, süreci takip edin ve arşivleyin.
                            Kurumsal iş akışını tek ekranda yönetin.
                        </p>

                        <div class="hero-cta">
                            <a class="btn btn-primary"
                               asp-area="Identity" asp-page="/Account/Login">
                                Giriş Yap
                            </a>

                            <a class="btn btn-outline-primary"
                               asp-area="Identity" asp-page="/Account/Register">
                                Ücretsiz Hesap Oluştur
                            </a>
                        </div>

                        <div class="mt-3 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Giriş yaptıktan sonra Dashboard + Gelen/Giden/Taslaklar ekranları aktif olur.
                        </div>
                    </div>

                    <div class="hero-right">
                        <div class="shot-frame">
                            <div class="shot-topbar">
                                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                                <span class="shot-title">EBYS Preview</span>
                            </div>

                            <div class="shot-body">
                                <img src="~/images/02-create-top.jpg"
                                     alt="EBYS ekran görüntüsü"
                                     onerror="this.remove(); document.getElementById('heroPh').classList.remove('d-none');" />

                                <div id="heroPh" class="shot-placeholder d-none">
                                    <div class="ic"><i class="bi bi-image"></i></div>
                                    <p class="t">Ekran görüntünü buraya koy</p>
                                    <p class="d">Dosya yolu: <b>wwwroot/images/02-create-top.jpg</b></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== Video + Duyurular ===== -->
        <section class="row-2col">
            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="panel glass-soft reveal">
                        <div class="panel-head">
                            <div class="left">
                                <div class="icon"><i class="bi bi-camera-video"></i></div>
                                <div>
                                    <p class="sec-title mb-0">AI Tanıtım</p>
                                    <p class="sec-sub">Sistem nasıl çalışır? 60 saniyede.</p>
                                </div>
                            </div>
                        </div>

                        <div class="video-wrap">
                            <iframe id="heygenFrame"
                                    src="https://app.heygen.com/embedded-player/978f1b4d48db4a7ead7785383278f8b7?autoplay=1&muted=1"
                                    title="HeyGen video player"
                                    allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                                    allowfullscreen>
                            </iframe>
                        </div>

                        <div class="mt-2 small text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Not: Bazı tarayıcılar otomatik oynatmayı sadece <b>sessiz (muted)</b> videolarda izin verir.
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="panel glass-soft reveal">
                        <div class="panel-head">
                            <div class="left">
                                <div class="icon"><i class="bi bi-megaphone"></i></div>
                                <div>
                                    <p class="sec-title mb-0">Duyurular</p>
                                    <p class="sec-sub">Güncellemeler • Bakım • Yeni özellikler</p>
                                </div>
                            </div>
                        </div>

                        <div class="ann-wrap">
                            <div class="ann-list">
                                <div class="ann-item">
                                    <div class="ann-dot"></div>
                                    <div>
                                        <p class="t">Planlı bakım</p>
                                        <p class="d">Sistem kısa süreli bakım moduna alınacaktır.</p>
                                        <div class="ann-meta">
                                            <span><i class="bi bi-calendar3 me-1"></i>20.12.2025</span>
                                            <span><i class="bi bi-clock me-1"></i>22:00</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ann-item">
                                    <div class="ann-dot"></div>
                                    <div>
                                        <p class="t">Yeni: PDF ön izleme</p>
                                        <p class="d">İmzacı ekranında belge PDF olarak görüntülenebilir.</p>
                                        <div class="ann-meta">
                                            <span><i class="bi bi-stars me-1"></i>UI iyileştirme</span>
                                            <span><i class="bi bi-check2-circle me-1"></i>Yayında</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ann-item">
                                    <div class="ann-dot"></div>
                                    <div>
                                        <p class="t">Performans güncellemesi</p>
                                        <p class="d">Liste ekranları daha hızlı yüklenecek şekilde optimize edildi.</p>
                                        <div class="ann-meta">
                                            <span><i class="bi bi-lightning-charge me-1"></i>Hız</span>
                                            <span><i class="bi bi-graph-up me-1"></i>İyileştirme</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="ann-item">
                                    <div class="ann-dot"></div>
                                    <div>
                                        <p class="t">Geri bildirim</p>
                                        <p class="d">Önerilerinizi destek kanalı üzerinden iletebilirsiniz.</p>
                                        <div class="ann-meta">
                                            <span><i class="bi bi-chat-dots me-1"></i>Destek</span>
                                            <span><i class="bi bi-arrow-right me-1"></i>İletişim</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div><!-- /ann-wrap -->
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== Features ===== -->
        <section class="cards-sec">
            <div class="glass-soft p-3 reveal">
                <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-2">
                    <div>
                        <p class="sec-title mb-0">Neler yapabilirsiniz?</p>
                        <p class="sec-sub">Belge yaşam döngüsünü tek ekranda yönetin.</p>
                    </div>
                </div>

                <div class="feat-grid">
                    <div class="feat">
                        <div class="i"><i class="bi bi-file-earmark-text"></i></div>
                        <h6>Belge Oluştur</h6>
                        <p>Üst veri + editör + ön izleme ile hızlı ve düzenli oluşturma.</p>
                    </div>

                    <div class="feat">
                        <div class="i"><i class="bi bi-send"></i></div>
                        <h6>İmzaya Gönder</h6>
                        <p>İmzacı seçimiyle süreç başlatın, bildirim ve takip yapın.</p>
                    </div>

                    <div class="feat">
                        <div class="i"><i class="bi bi-inbox"></i></div>
                        <h6>Gelen Kutusu</h6>
                        <p>Bekleyen imzaları görüntüleyin, onay/red işlemini tamamlayın.</p>
                    </div>

                    <div class="feat">
                        <div class="i"><i class="bi bi-archive"></i></div>
                        <h6>Arşiv & PDF</h6>
                        <p>PDF çıktısı alın, arşivleyin ve gerektiğinde geri yükleyin.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== Gallery ===== -->
        <section class="gallery">
            <div class="glass-soft p-3 reveal">
                <div class="mb-2">
                    <p class="sec-title mb-0">Ekran Görüntüleri</p>
                    <p class="sec-sub">Görselleri sonradan değiştirirsin (şimdilik placeholder).</p>
                </div>

                <div class="shots">
                    <div class="shot">
                        <img src="~/images/ss1.jpg" alt="EBYS ekran 1"
                             onerror="this.style.opacity=.12; this.style.filter='grayscale(1)';" />
                        <div class="cap">
                            <p class="t">Dashboard</p>
                            <p class="d">Kutu özetler + hızlı aksiyonlar</p>
                        </div>
                    </div>

