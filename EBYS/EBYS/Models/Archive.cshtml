@model List<EBYS.Models.Document>

<h4>Arşiv</h4>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Sayı</th>
            <th>Başlık</th>
            <th>Durum</th>
            <th>Arşiv Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr>
                <td>@d.Sayi</td>
                <td>@d.Baslik</td>
                <td>@d.Durum</td>
                <td>@d.DeletedAt?.ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>
