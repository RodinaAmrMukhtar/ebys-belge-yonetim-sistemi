@page
@model RegisterModel

@{
    ViewData["Title"] = "Hesap Oluştur";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EBYS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --glass-bg: rgba(255,255,255,.70);
            --glass-bd: rgba(255,255,255,.42);
            --glass-shadow: 0 22px 70px rgba(0,0,0,.18);
            --ink: #0f172a;
            --muted: #64748b;
            --blue: #0d6efd;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            background: radial-gradient(1200px 600px at 10% 0%, rgba(13,110,253,.14), transparent 55%), radial-gradient(900px 520px at 100% 10%, rgba(99,102,241,.12), transparent 55%), url('/images/Login.png') no-repeat center bottom / cover, #f6f7fb;
        }

        .ebys-card {
            width: min(520px, 92vw);
            border-radius: 18px;
            padding: 16px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-bd);
            box-shadow: var(--glass-shadow);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .ebys-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 10px;
            border-radius: 16px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(15,23,42,.08);
            margin-bottom: 12px;
        }

        .ebys-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

            .ebys-brand img {
                height: 42px;
            }

            .ebys-brand .name {
                font-weight: 900;
                color: var(--ink);
                margin: 0;
                line-height: 1.05;
            }

            .ebys-brand .desc {
                color: var(--muted);
                font-size: .78rem;
                margin: 0;
            }

        .ebys-badge {
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.14);
            color: var(--ink);
            border-radius: 999px;
            padding: 6px 10px;
            font-size: .80rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .ebys-title {
            font-weight: 900;
            color: var(--ink);
            margin: 10px 0 4px 0;
        }

        .ebys-sub {
            color: var(--muted);
            margin: 0 0 12px 0;
            font-size: .92rem;
        }

        .ebys-field .field-hint {
            display: none;
            margin-top: 6px;
            font-size: .78rem;
            color: var(--muted);
        }

        .ebys-field.has-focus .field-hint {
            display: block;
        }

        .form-control {
            border-radius: 12px;
        }

            .form-control:focus {
                border-color: rgba(13,110,253,.45);
                box-shadow: 0 0 0 .2rem rgba(13,110,253,.18);
            }

        .ebys-btn {
            border-radius: 12px;
            padding: 10px 12px;
            box-shadow: 0 10px 24px rgba(0,0,0,.08);
            transition: transform .16s ease, box-shadow .16s ease;
            font-weight: 800;
        }

            .ebys-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 14px 30px rgba(0,0,0,.10);
            }

        .ebys-linkchip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            border: 1px solid rgba(15,23,42,.12);
            background: rgba(255,255,255,.80);
            text-decoration: none;
            color: var(--ink);
            font-weight: 700;
            font-size: .84rem;
        }

            .ebys-linkchip:hover {
                background: rgba(13,110,253,.06);
                border-color: rgba(13,110,253,.25);
                color: var(--ink);
            }

        .ebys-note {
            border-radius: 14px;
            padding: 10px 12px;
            background: rgba(255,255,255,.62);
            border: 1px solid rgba(15,23,42,.07);
            color: var(--muted);
            font-size: .86rem;
            margin-top: 12px;
        }
    </style>
</head>

<body>
    <main class="ebys-card">

        <div class="ebys-top">
            <div class="ebys-brand">
                <img src="~/images/BLUE.png" alt="EBYS" />
                <div>
                    <p class="name mb-0">EBYS</p>
                    <p class="desc mb-0">Elektronik Belge Yönetim Sistemi</p>
                </div>
            </div>

            <span class="ebys-badge">
                <i class="bi bi-person-plus"></i>
                <span>Kayıt</span>
            </span>
        </div>

        <h5 class="ebys-title">Hesap Oluştur</h5>
        <p class="ebys-sub">Yeni kullanıcı oluşturun ve sisteme giriş yapın.</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3 ebys-field">
                <label asp-for="Input.Email" class="form-label fw-semibold">E-posta</label>
                <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                <div class="field-hint"><i class="bi bi-info-circle me-1"></i>Giriş için kullanılacak adres.</div>
            </div>

            <div class="mb-3 ebys-field">
                <label asp-for="Input.Password" class="form-label fw-semibold">Parola</label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                <div class="field-hint"><i class="bi bi-shield-lock me-1"></i>Güçlü parola önerilir.</div>
            </div>

            <div class="mb-3 ebys-field">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Parola (Tekrar)</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                <div class="field-hint"><i class="bi bi-check2-circle me-1"></i>Parola eşleşmeli.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100 ebys-btn">
                <i class="bi bi-person-check me-2"></i>Hesap Oluştur
            </button>

            <div class="text-center mt-3">
                <a asp-page="./Login" class="ebys-linkchip">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Zaten hesabın var mı? Giriş yap</span>
                </a>
            </div>

            <div class="ebys-note">
                <i class="bi bi-lightning-charge me-1"></i>
                İpucu: Kayıttan sonra giriş yapıp “Yeni Belge” akışını direkt kullanabilirsin.
            </div>
        </form>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.ebys-field input, .ebys-field textarea, .ebys-field select').forEach(el => {
            el.addEventListener('focus', () => el.closest('.ebys-field')?.classList.add('has-focus'));
            el.addEventListener('blur', () => el.closest('.ebys-field')?.classList.remove('has-focus'));
        });
    </script>
</body>
</html>
